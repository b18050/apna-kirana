# Copy to apps/web/.env
# Local: SQLite (zero cost). Production: Neon Postgres URL (ap-south-1 / Asia).
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-long-random-string"
ADMIN_EMAIL="owner@apnakirana.in"
ADMIN_PASSWORD="change-me"

# Optional India SMS (Fast2SMS). If empty, OTP appears on /admin/otps.
FAST2SMS_API_KEY=""

# Optional Expo push (EAS). If empty, status still updates in-app.
EXPO_ACCESS_TOKEN=""
